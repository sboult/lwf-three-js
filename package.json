{
  "name": "spinning-lambda-web-function",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build": "tsc --noEmit && npm run build:web",
    "test": "node --test test/*.test.ts",
    "local": "node --watch src/local.ts",
    "synth": "npm run build:web && cdk synth --strict",
    "deploy": "npm run build:web && cdk deploy",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.4.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.10",
    "aws-cdk": "^2.1145.0",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3"
  }
}
